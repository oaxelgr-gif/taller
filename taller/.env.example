# Copia este archivo como ".env" y ajusta los valores.
SECRET_KEY=cambia-esto-por-una-cadena-larga-y-aleatoria
FLASK_DEBUG=0

# Conexión a PostgreSQL (opción A: URL completa)
# DATABASE_URL=postgresql+psycopg2://taller_user:taller_pass@localhost:5432/taller_mecanico

# Conexión a PostgreSQL (opción B: variables separadas)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=taller_mecanico
DB_USER=taller_user
DB_PASSWORD=taller_pass

# Zona horaria del taller (para mostrar y validar fechas)
APP_TIMEZONE=America/Mexico_City
# Nombre que aparece en el sistema y en los reportes
TALLER_NOMBRE=Taller Mecánico
# Puerto del servidor
PORT=5000
# Solo True si sirves la app por HTTPS
SESSION_COOKIE_SECURE=0

# --- Primer arranque con Docker ---
# Contraseña del usuario "admin" que se crea si la base está vacía.
# Si la dejas vacía se genera una aleatoria y se muestra en los logs (docker compose logs web).
ADMIN_PASSWORD=
# 1 = cargar mecánicos y catálogo de demostración (sólo para pruebas, nunca en el taller real)
CARGAR_DEMO=0
